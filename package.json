{
  "name": "devops-lab-nodejs-project",
  "version": "1.0.0",
  "description": "DevOps Lab Node.js project — core API (/version, /info, /boom, /health) built for the ESILV TP4 DevOps workflow.",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node src/server.js",
    "start": "node src/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "vitest": {
    "coverage": {
      "provider": "v8",
      "all": true,
      "include": ["src/**/*.js"],
      "exclude": ["**/server.js"],
      "lines": 80,
      "functions": 80,
      "branches": 70,
      "statements": 80
    }
  },
  "author": "Arthur Barraine",
  "license": "MIT",
  "dependencies": {
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.14.0",
    "globals": "^15.12.0",
    "supertest": "^7.0.0",
    "vitest": "^2.1.9"
  }
}
